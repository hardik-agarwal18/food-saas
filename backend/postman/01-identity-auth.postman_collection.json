        {
          "name": "Get Current User (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Matches environment email\", function () {",
                  "    pm.expect(body.data.email).to.eql(pm.environment.get(\"email\"));",
                  "});"
