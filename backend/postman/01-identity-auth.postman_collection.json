  "item": [
    {
      "name": "01 Registration",
      "item": [
        {
          "name": "Register User (Success)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "pm.environment.set(\"email\", `testuser_${timestamp}@example.com`);",
                  "pm.environment.set(\"password\", \"Test1234!\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Response has success flag\", function () {",
                  "    pm.expect(body.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Tokens are present\", function () {",
                  "    pm.expect(body.data).to.have.property('accessToken');",
                  "    pm.expect(body.data).to.have.property('refreshToken');",
                  "    pm.environment.set(\"accessToken\", body.data.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.data.refreshToken);",
                  "    pm.environment.set(\"userId\", body.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"phone\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "identity",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register User (Duplicate Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 or 400\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});",
                  "",
                  "pm.test(\"Response is error\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
