{
  "info": {
    "_postman_id": "cc33dd44-ee55-ff66-gg77-hh88ii99jj00",
    "name": "Food SaaS — 03 Menu Management",
    "description": "Test suite for Menu categories, items, modifier groups, modifier items, and menu imports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Setup & Auth",
      "description": "Login as Restaurant Owner to get access to menu APIs.",
      "item": [
        {
          "name": "Login as Restaurant Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if(body.success) {",
                  "    pm.environment.set(\"restaurantAccessToken\", body.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{restaurantEmail}}\",\n    \"password\": \"{{restaurantPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "identity", "login"]
            }
          }
        }
      ]
    },
