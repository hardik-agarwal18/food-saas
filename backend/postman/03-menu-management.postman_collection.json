          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{restaurantAccessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "restaurants", "{{restaurantId}}", "menu", "import"]
            },
            "description": "Requires selecting a PDF/Image file manually in Postman."
