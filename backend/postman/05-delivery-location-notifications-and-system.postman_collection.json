            "url": {
              "raw": "{{baseUrl}}/api/v1/deliveries/{{deliveryAssignmentId}}/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deliveries", "{{deliveryAssignmentId}}", "claim"]
            }
          }
        },
        {
          "name": "Get My Driver Assignments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverAccessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/deliveries/driver/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "deliveries", "driver", "assignments"]
            }
          }
        }
      ]
    },
